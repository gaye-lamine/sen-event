# ============================================================================
# SUNU EVENTS - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ============================================================================

# Active le mode API réel au lieu des données de démonstration locales
VITE_USE_REAL_BACKEND=false

# URL de base de votre API Backend (REST / GraphQL)
# Exemples :
# Node.js/Express : http://localhost:5000/api/v1
# Laravel : http://localhost:8000/api
# Django : http://localhost:8000/api/v1
# Supabase / Production : https://api.sunuevents.sn/v1
VITE_API_URL=http://localhost:5000/api/v1
